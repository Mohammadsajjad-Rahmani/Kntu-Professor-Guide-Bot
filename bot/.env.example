# Copy this file to .env and fill in the values. Never commit .env.
BOT_TOKEN=123456:replace-with-token-from-BotFather
DATABASE_URL=sqlite+aiosqlite:///./vahedyar.db
# Telegram numeric IDs of admins, comma separated
ADMIN_IDS=
# Channel where approved reviews are published, e.g. -1001234567890 (used from phase 1b)
CHANNEL_ID=
# Local proxy (e.g. v2ray) to reach Telegram from Iran. Leave empty on a server abroad.
PROXY_URL=
# true: admins approve every review before it is published. false: publish right away.
REQUIRE_APPROVAL=true
# Max reviews one student can submit per 24 hours
DAILY_REVIEW_LIMIT=5
# Trusted students: after this many approved reviews, clean reviews skip manual approval.
# 0 = off (every review waits for an admin)
AUTO_PUBLISH_AFTER=0
